# --- Serveur ---
NODE_ENV=development
PORT=4000
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (Supabase → Settings/Database → Connection string, mode Session) ---
# `connect_timeout` est nécessaire : le délai par defaut de Prisma (~5 s) est
# trop court pour joindre le pooler Supabase en Europe de l'Ouest depuis un
# reseau distant, ce qui se manifestait par un « P1001 » trompeur.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?connect_timeout=60

# --- Authentification JWT ---
# Secret de signature (min 8 car.) — à remplacer en production
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Connexion Google (optionnelle) ---
# Client ID de la console Google Cloud. Laissez vide pour désactiver la
# connexion Google : le login e-mail / mot de passe reste opérationnel.
# Créez un client de type « Application Web » (Web) et « Android » (mobile),
# en ajoutant les origines/empreintes SHA-1 correspondantes.
GOOGLE_CLIENT_ID=
