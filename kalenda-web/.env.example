# URL publique de l'API Alliya Kalenda (kalenda-backend).
# En local : http://localhost:4000
# En production : remplacez par le domaine heberge (ex. https://api.alliyakalenda.com)
# Laissez la variable vide pour rester en mode demonstration hors ligne.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Connexion Google (facultative) — Client ID de la console Google Cloud,
# type « Application Web ». Renseignez aussi les origines autorisees
# (http://localhost:3000 en dev). Vide = bouton Google masque.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
